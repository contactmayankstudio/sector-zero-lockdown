[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends GPUParticles3D

@onready var mist = get_node_or_null(\"BloodMist\")

func play_effect():
	show()
	restart()
	emitting = true
	if mist:
		mist.restart()
		mist.emitting = true
	if is_inside_tree():
		await get_tree().create_timer(0.6).timeout
		if not emitting:
			hide()
"

