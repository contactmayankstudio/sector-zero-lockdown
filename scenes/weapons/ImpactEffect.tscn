[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends GPUParticles3D

@onready var dust = get_node_or_null(\"ImpactDust\")
@onready var sparks = get_node_or_null(\"ImpactSparks\")

func play_effect():
	show()
	restart()
	emitting = true
	if dust:
		dust.restart()
		dust.emitting = true
	if sparks:
		sparks.restart()
		sparks.emitting = true
	if is_inside_tree():
		await get_tree().create_timer(0.55).timeout
		if not emitting:
			hide()
"

