[sub_resource type="GDScript" id="GDScript_gore"]
script/source = "extends CPUParticles3D

func _ready():
	emitting = true
	var chunks = get_node_or_null(\"GoreChunks\")
	if chunks:
		chunks.emitting = true
	if is_inside_tree() and get_tree():
		await get_tree().create_timer(0.85).timeout
		queue_free()
"

